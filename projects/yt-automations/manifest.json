{
  "manifest_version": 3,
  "name": "YT Auto-Transcriber",
  "version": "1.0",
  "description": "One-click transcription of YouTube videos on youtubetotranscript.com/io.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtubetotranscript.com/*",
        "https://*.youtubetotranscript.com/*",
        "https://youtubetotranscript.io/*",
        "https://*.youtubetotranscript.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
